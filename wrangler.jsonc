{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omar-magdy-portfolio",
  "account_id": "9dce0054a4406023fe042fdc30ae7ff4",
  "main": "worker/worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
    // Static files are served without running the Worker; only the API and the admin page invoke it.
    "run_worker_first": ["/api/*", "/dax-admin"]
  },
  // Create once with `npx wrangler d1 create omar-portfolio`, then paste the database_id here.
  // Secrets (not stored here): ADMIN_TOKEN and HASH_SALT -> `npx wrangler secret put ADMIN_TOKEN`.
  "d1_databases": [
    { "binding": "DB", "database_name": "omar-portfolio", "database_id": "2d737888-60c5-4c23-9df6-acf2870560da", "migrations_dir": "migrations" }
  ],
  // Per-IP request limits, enforced by Cloudflare before any database work happens.
  "ratelimits": [
    { "name": "RL_EVENTS", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_SUBMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "1003", "simple": { "limit": 240, "period": 60 } },
    { "name": "RL_ADMIN", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "workers_dev": true,
  "routes": [{ "pattern": "omar.daaw.dev", "custom_domain": true }]
}
